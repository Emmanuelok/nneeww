# Database (Supabase Postgres, ca-central-1 region)
DATABASE_URL="postgresql://postgres:[password]@[host]:5432/postgres"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Stripe (CAD)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PRICE_SOLO=""
NEXT_PUBLIC_STRIPE_PRICE_TEAM=""
NEXT_PUBLIC_STRIPE_PRICE_MULTI=""

# Resend
RESEND_API_KEY=""
RESEND_FROM_EMAIL="people@yourdomain.ca"
RESEND_FROM_NAME="Your People Team"
RESEND_WEBHOOK_SECRET=""

# Sentry / PostHog (optional in dev)
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set to "false" once you've configured Supabase + DATABASE_URL above and want
# the /app workspace to read live tenant data instead of the seeded demo set.
CLEARPOST_DEMO_MODE="true"

# Shared secret for the Vercel Cron daily-digest job. Vercel automatically
# attaches Authorization: Bearer <CRON_SECRET> when invoking scheduled paths.
CRON_SECRET=""
